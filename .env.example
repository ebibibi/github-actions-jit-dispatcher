GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
RUNNER_IMAGE=ghactions-runner:latest
MAX_CONCURRENT=10
# Repos allowed to mount the host Docker socket (= root on the host).
# Leave empty unless a repo builds images AND never runs outside contributors' code.
DOCKER_SOCKET_REPOS=
RUNNER_MEMORY=8g
RUNNER_CPUS=4
RUNNER_PIDS_LIMIT=2048
